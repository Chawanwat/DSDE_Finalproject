# Copy to .env and fill in. Never commit .env.
# API keys for external data sources (src/bkk_cctv/scrape/)
WEATHER_API_KEY=
# Optional: override where raw images live (e.g. external drive)
# RAW_IMAGES_DIR=/Volumes/data/bkk_cctv/raw

# Kafka broker. Inside docker compose this is set to kafka:29092 automatically;
# use localhost:9092 when running Python directly on your machine.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
